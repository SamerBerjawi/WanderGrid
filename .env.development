# Loaded by `npm run dev` only (never by `vite build`).
# Local mode: all data lives in this browser's localStorage and no backend or database is needed.
# To develop against the API instead, create .env.development.local (git-ignored) containing:
#   VITE_LOCAL_MODE=false
# and run the backend with PORT=3001 (see CLAUDE.md).
VITE_LOCAL_MODE=true

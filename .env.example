# WanderGrid Environment Configuration Example
# Copy this file to .env or configure these variables inside your Portainer Stack environment settings.

# The tag/version of the WanderGrid image to run (e.g., 'latest', 'main', or a specific commit SHA like 'sha-9debe16')
# Specifying a specific SHA prevents Portainer from using a stale local cache and forces pulling the correct build.
WANDERGRID_TAG=latest

# Port mapped to the host
APP_PORT=4921

# Directory on host where PostgreSQL database files will be persisted
POSTGRES_DATA_DIR=./postgres_data

# Secret key used for signing JSON Web Tokens (JWT) for secure session authentication. 
# Change this to a random long string in production environments!
JWT_SECRET=wandergrid_super_secret_development_key_change_me_in_production

# PostgreSQL Database Credentials
DB_USER=wandergrid
DB_PASSWORD=wandergrid_password
DB_NAME=wandergrid

# --- Database Pool Limits & Connection Tuning ---
# Maximum client connections concurrently managed by the database pool (defaults to 20)
DB_POOL_SIZE=20

# Amount of milliseconds before abandoning a pending database server lookup (defaults to 5000)
DB_CONNECTION_TIMEOUT_MS=5000

# Strict statement runtime execution limit in milliseconds to avoid long-running locks (defaults to 10000)
DB_STATEMENT_TIMEOUT_MS=10000

# --- Caching, Lookups, and Externals Configuration ---
# Live Flights cache lifecycle TTL in milliseconds (defaults to 5 minutes)
API_CACHE_TTL_MS=300000

# Global static airport/carrier datasets refresh interval in milliseconds (defaults to 7 days)
GLOBAL_DATA_REFRESH_MS=604800000

# Persistent Geocoding items cache lookup lifecycle TTL in milliseconds (defaults to 30 days)
GEOCODE_CACHE_TTL_MS=2592000000

# External geocoding lookup web service timeout threshold in milliseconds (defaults to 3000)
EXTERNAL_FETCH_TIMEOUT_MS=3000
